# Public template only. Keep every credential field blank in this repository.
# Copy to a private path OUTSIDE the checkout, then populate that external copy.

# First public release target; use only after this version is published.
LUNAR_PAPER_VERSION=0.8.0
# Optional image repository override, without a tag. LUNAR_PAPER_VERSION supplies it.
# LUNAR_PAPER_IMAGE=ghcr.io/lunarpaper/platform
# PostgreSQL is versioned independently; keep major 17 and the existing data path.
# POSTGRES_IMAGE=postgres:17-alpine
# Optional separate Compose instance; choose an unused name for fresh storage.
# COMPOSE_PROJECT_NAME=lunarpaper-test
# Exact browser origin, no trailing slash/path. Examples:
# HTTP on this computer: http://localhost:3000
# HTTP on the LAN: http://192.168.1.20:3000
# Internal HTTPS: https://paper.internal
APP_URL=

# Optional browser-cookie isolation. Set a unique value on each additional Lunar
# Paper deployment that users open through the same hostname or IP address.
# COOKIE_NAMESPACE=lunarpaper_test
# Optional exact private publisher targets; configure only for the intended publisher.
# PUBLISHER_PRIVATE_TARGETS=

# HTTP defaults match the installation guide. For LAN use, set an IP assigned to your server.
# HTTP_BIND_ADDRESS=127.0.0.1
# HOST_PORT=3000

# HTTPS defaults to Caddy's internal CA. Trust its root on your client computers.
# For public ACME certificates with suitable DNS/validation, uncomment a blank value:
# CADDY_TLS_DIRECTIVE=

# First administrator: email address and a unique strong password (12 or more
# characters, including an upper-case letter, lower-case letter, number and symbol).
SYSTEM_ADMIN_USERNAME=
SYSTEM_ADMIN_PASSWORD=

# Generate EACH value independently as 32 random bytes encoded as 64 lowercase
# hexadecimal characters. See the operating-system commands in README.md.
# Save all values securely; preserve them across restarts and upgrades.
# Mandatory at startup. Unlocks web setup; never reuse another secret.
SETUP_KEY=
SESSION_SECRET=
ENCRYPTION_KEY=
WORKFLOW_CREDENTIAL_ENCRYPTION_KEY=
INTERNAL_API_TOKEN=
AI_ENCRYPTION_KEY=
MFA_ENCRYPTION_KEY=
SSO_ENCRYPTION_KEY=
DATA_SOURCE_ENCRYPTION_KEY=
PUBLISHER_CREDENTIAL_ENCRYPTION_KEY=
EMAIL_ENCRYPTION_KEY=
ADDRESS_PROVIDER_ENCRYPTION_KEY=
EMAIL_TRACKING_SECRET=
PDF_EXPORT_SECRET=

# JSON keyring: {"v1":"<independently generated 64-character hex key>"}
# Preserve this keyring. Retain old keys if existing files still need them.
FORM_FILE_ENCRYPTION_KEYS=

# Optional PostgreSQL owner name for a fresh installation (default: postgres).
# Use lowercase letters, numbers and underscores; keep app_* and pg_* names reserved.
# PGUSER=postgres
# Optional runtime login names; choose distinct names before first setup.
# APP_PLATFORM_USER=app_platform
# APP_INTAKE_USER=app_intake
# Custom names: lowercase letter first, then letters/digits/underscores, max 63.
# Keep app_*, pg_*, postgres, public, svc_datalayer and reporting reserved.
# Existing databases require operator-managed role changes; env edits do not rename users.
# Generate each independently using the operating-system command in README.md.
# Hex values are URL-safe for the database connection strings in compose.yaml.
PGPASSWORD=
APP_PLATFORM_PASSWORD=
APP_INTAKE_PASSWORD=
REDIS_PASSWORD=

# Optional remote data layer. Omit these for the standard local execution path.
# Configure a separate service and its registered instance before enabling this.
# DATA_LAYER_ENABLED=true
# DATA_LAYER_URL=https://data.example.com
# DATA_LAYER_ALLOWED_ENDPOINTS=https://data.example.com
# DATA_LAYER_API_KEY=<independent instance key, only in your private env file>

# Optional storage sources: retain the defaults or set absolute host folder paths.
# Changing these settings does not move existing data.
# POSTGRES_DATA=postgres-data
# REDIS_DATA=redis-data
# UPLOADS_DATA=uploads-data
# SEAWEEDFS_DATA=seaweedfs-data
