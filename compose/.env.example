# Public template only. Keep every credential field blank in this repository.
# Copy to a private path OUTSIDE the checkout, then populate that external copy.

# Download the generated release bundle. Its compose.yaml already pins the
# matching application and database images; no image settings are required here.
# Exact browser origin, no trailing slash/path. Examples:
# HTTP on this computer: http://localhost:3000
# HTTP on the LAN: http://192.168.1.20:3000
# Internal HTTPS: https://paper.internal
APP_URL=

# Optional browser-cookie isolation. Set a unique value on each additional Lunar
# Paper deployment that users open through the same hostname or IP address.
# COOKIE_NAMESPACE=paper_internal

# Optional HTTP listener. Set to an IP actually assigned to your server for LAN use.
# HTTP_BIND_ADDRESS=192.168.1.20
# HOST_PORT=3000

# HTTPS defaults to Caddy's internal CA. Trust its root on your client computers.
# For public ACME certificates with suitable DNS/validation, uncomment a blank value:
# CADDY_TLS_DIRECTIVE=

# First administrator: email address and a unique strong password.
SYSTEM_ADMIN_USERNAME=
SYSTEM_ADMIN_PASSWORD=

# Generate EACH value independently as 32 random bytes encoded as 64 lowercase
# hexadecimal characters. See the operating-system commands in README.md.
# Save all values securely; preserve them across restarts and upgrades.
# Mandatory at startup. Unlocks web setup; never reuse another secret.
SETUP_KEY=
SESSION_SECRET=
ENCRYPTION_KEY=
INTERNAL_API_TOKEN=
AI_ENCRYPTION_KEY=
MFA_ENCRYPTION_KEY=
SSO_ENCRYPTION_KEY=
DATA_SOURCE_ENCRYPTION_KEY=
PUBLISHER_CREDENTIAL_ENCRYPTION_KEY=
EMAIL_ENCRYPTION_KEY=
ADDRESS_PROVIDER_ENCRYPTION_KEY=
EMAIL_TRACKING_SECRET=
PDF_EXPORT_SECRET=

# JSON keyring: {"v1":"<independently generated 64-character hex key>"}
# Preserve this keyring. Retain old keys if existing files still need them.
FORM_FILE_ENCRYPTION_KEYS=

# Generate each independently using the operating-system command in README.md.
# Hex values are URL-safe for the database connection strings in compose.yaml.
PGPASSWORD=
APP_PLATFORM_PASSWORD=
APP_INTAKE_PASSWORD=
REDIS_PASSWORD=

# Optional remote data layer. Omit these for the standard local execution path.
# Configure a separate service and its registered instance before enabling this.
# DATA_LAYER_ENABLED=true
# DATA_LAYER_URL=https://data.example.com
# DATA_LAYER_ALLOWED_ENDPOINTS=https://data.example.com
# DATA_LAYER_API_KEY=<independent instance key, only in your private env file>
